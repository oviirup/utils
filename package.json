{
  "name": "@oviirup/utils",
  "version": "1.1.1",
  "description": "Collection of common JavaScript / TypeScript utilities bt @oviirup",
  "repository": "github:oviirup/utils",
  "license": "MIT",
  "author": "Avirup Ghosh (github.com/oviirup)",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./array": "./dist/array.js",
    "./guards": "./dist/guards.js",
    "./nanoid": "./dist/nanoid.js",
    "./number": "./dist/number.js",
    "./object": "./dist/object.js",
    "./picocolors": "./dist/picocolors.js",
    "./promise": "./dist/promise.js",
    "./string": "./dist/string.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/**/*.ts --dts --exports --no-fixed-extension --unbundle",
    "format": "biome format --write",
    "lint": "biome check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.4",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
